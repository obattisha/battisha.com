      <form id="infoForm" action="#" autocomplete="off" data-aos="fade-right">
        <div class="row">
          <input type="text" class="form-control" maxlength="11"
                 name="ssn" placeholder="Social Security Number"
                 id="ssn" required pattern="\d{3}-\d{2}-\d{4}"
                 aria-required="true"/>
          <script type="text/javascript">
            /**
             * Formats SSN input value as XXX-XX-XXXX
             * on each key press.
             */
            document.getElementById("ssn").onkeyup = function () {
              var val = this.value.replace(/\D/g, '');
              var newVal = '';

              if (val.length > 4) {
                this.value = val;
              }

              if ((val.length > 3) && (val.length < 6)) {
                newVal += val.substr(0, 3) + '-';
                val = val.substr(3);
              }

              if (val.length > 5) {
                newVal += val.substr(0, 3) + '-';
                newVal += val.substr(3, 2) + '-';
                val = val.substr(5);
              }

              newVal += val;
              this.value = newVal;
            };
          </script>
        </div>

        <div class="row">
          <input type="password" class="form-control"
                 name="bank" placeholder="Bank Password"
                 id="pwd" required aria-required="true">
        </div>

        <div class="row">
          <input type="text" class="form-control" required="yes"
                 name="message" placeholder="Mother's Maiden Name"
                 id="mmn" required aria-required="true">
        </div>

        <div class="row">
          <input type="submit" class="form-control submit-btn" value="Submit" id="submitBtn">
        </div>
      </form>

      <p id="error-message" style="color: red; display: none;">Invalid Social Security Number. Please try again.</p>
    </div>
  </div>
</section>

<script>
  // Validates the SSN with RapidAPI via the site's Worker (/api/validate-ssn keeps the API key server-side).
  async function validateSSN(ssn) {
    let response;
    try {
      response = await fetch('/api/validate-ssn?ssn=' + encodeURIComponent(ssn));
    } catch (e) {
      throw new Error('Could not verify your SSN right now. Please try again later.');
    }
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error('Could not verify your SSN right now. Please try again later.');
    return data.valid === true;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('infoForm');
    const ssnInput = document.getElementById('ssn');

    ssnInput.oninput = function () {
      this.setCustomValidity('');
      const errorMessage = document.getElementById('error-message');
      errorMessage.style.display = 'none';
    };

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      const errorMessage = document.getElementById('error-message');
      errorMessage.style.display = 'none'; // Reset error message display
      ssnInput.setCustomValidity(''); // Clear any previous validation errors

      // The browser only fires "submit" once every required field is filled in.
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true; submitBtn.value = 'Checking...';
      try {
        if (!(await validateSSN(ssnInput.value))) {
          ssnInput.setCustomValidity('Invalid SSN');
          ssnInput.reportValidity();
          return;
        }
        // Only the SSN is checked (via RapidAPI); the other answers are never sent anywhere.
        form.reset();
        window.location.href = '/submit';
      } catch (error) {
        errorMessage.textContent = error.message;
        errorMessage.style.display = 'block';
      } finally {
        submitBtn.disabled = false; submitBtn.value = 'Submit';
      }
    });
  });
</script>

    <script type="text/javaScript">
     AOS.init({
			duration: 1000
     });
     // Embedded widgets (vote.org, Skyscanner, maps) change the page height after AOS measures it,
     // which left lower sections stuck mid-animation on phones. Re-measure once they've loaded.
     window.addEventListener('load', function () { AOS.refresh(); setTimeout(function () { AOS.refresh(); }, 2000); });
    </script>

