        <script>
            /**
             * CountryTracker Class
             * Needs to be instantiated AFTER the HTML elements exist.
             */
            class CountryTracker {
                constructor(containerElement) { // Accept container element
                    // --- User's Data ---
                    this.visitedCountries = new Set();
        
                    // --- Application State & Configuration ---
                    this.countries = [];
                    this.map = null;
                    this.polygonSeries = null;
                    this.displayOverrides = {
                        'Israel': 'Occupied Palestine',
                        'Palestine': 'Occupied Palestine',
                        'Palestinian Territories': 'Occupied Palestine'
                    };
                    this.mapNameToApiName = {
                        'Türkiye': 'Turkey',
                        'Democratic Republic of Congo': 'DR Congo',
                        'eSwatini': 'Eswatini',
                        'United States of America': 'United States',
                        'Russian Federation': 'Russia',
                        'Republic of Serbia': 'Serbia',
                        "Côte d'Ivoire": 'Ivory Coast',
                        'Republic of Congo': 'Republic of the Congo',
                        'Lao People\'s Democratic Republic': 'Laos',
                        'Palestinian Territories': 'Palestine'
                    };
                    this.excludedStates = new Set(['IL', 'ISR']);
        
                    // --- Owner's Visited Countries List ---
                    this.ownerVisitedCountries = new Set([
                        "Australia", "Austria", "Belgium", "Canada", "Colombia", "Costa Rica",
                        "Egypt", "France", "Germany", "Hong Kong", "Ireland", "Italy", "Japan",
                        "Malaysia", "Mexico", "Morocco", "Netherlands", "New Zealand", "Oman", "Panama",
                        "Portugal", "Qatar", "Saudi Arabia", "Singapore", "South Africa",
                        "South Korea", "Spain", "Switzerland", "Taiwan", "Tanzania", "Thailand", "Türkiye", "United Kingdom",
                        "Greece", "Hungary", "Romania", "Slovenia",
                        "United States", "Vatican City", "Zambia", "Zimbabwe"
                    ]);
        
                    // --- UI Element References (Scoped to container) ---
                    this.container = containerElement; // Store the container
                    this.countryInput = this.container.querySelector('#countryInput');
                    this.suggestionsDiv = this.container.querySelector('#suggestions');
                    this.resetButton = this.container.querySelector('#resetButton');
                    this.compareButton = this.container.querySelector('#compareButton');
                    this.visitedListUl = this.container.querySelector('#visitedList');
                    this.comparisonResultsDiv = this.container.querySelector('#comparisonResults');
                    this.countryCountSpan = this.container.querySelector('#countryCount');
                    this.totalCountriesSpan = this.container.querySelector('#totalCountries');
                    this.countBanterSpan = this.container.querySelector('#countBanter');
                    this.mapDiv = this.container.querySelector('#map'); // Get map div reference
        
        
                    // Start the initialization process
                    this.init();
                }
        
                /**
                 * Initializes the tracker by fetching country data, setting up the map,
                 * adding event listeners, and loading saved data.
                 */
                async init() {
                    // Ensure map div exists before proceeding
                     if (!this.mapDiv) {
                         console.error("Map container div not found within the provided element.");
                         return;
                     }
                    try {
                        const response = await fetch('/data/countries.json');
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        const data = await response.json();
        
                        this.countries = data
                            .filter(country => country.name?.common)
                            .map(country => ({ name: country.name.common, code: country.cca2, code3: country.cca3 }))
                            .sort((a, b) => a.name.localeCompare(b.name));
        
                        this.totalCountriesSpan.textContent = this.countries.length;
        
                        this.initializeMap(); // Pass the specific map div id
                        this.setupEventListeners();
                        this.loadSavedCountries();
        
                    } catch (error) {
                        console.error('Error initializing the tracker:', error);
                        this.displayError("Could not load country data. Please try refreshing the page.");
                    }
                }
        
                 /** Displays an error message to the user within the tracker container. */
                displayError(message) {
                    let errorDiv = this.container.querySelector('.error-message');
                    if (!errorDiv) {
                        errorDiv = document.createElement('div');
                        errorDiv.className = 'error-message';
                        errorDiv.style.color = 'red';
                        errorDiv.style.backgroundColor = '#ffebee';
                        errorDiv.style.border = '1px solid red';
                        errorDiv.style.padding = '10px';
                        errorDiv.style.marginTop = '10px';
                        errorDiv.style.borderRadius = '5px';
                        // Prepend error within the tracker container
                        this.container.insertBefore(errorDiv, this.container.firstChild);
                    }
                    errorDiv.textContent = `Error: ${message}`;
                }
        
                /** Sets up the amCharts world map. */
                initializeMap() {
                    am4core.useTheme(am4themes_animated);
                    // *** Create chart in the specific map div ***
                    let chart = am4core.create(this.mapDiv, am4maps.MapChart);
                    this.map = chart;
        
                    chart.geodata = am4geodata_worldLow;
                    chart.projection = new am4maps.projections.Miller();
        
                    let polygonSeries = chart.series.push(new am4maps.MapPolygonSeries());
                    this.polygonSeries = polygonSeries;
                    polygonSeries.useGeodata = true;
                    polygonSeries.exclude = ["AQ"];
        
                    let polygonTemplate = polygonSeries.mapPolygons.template;
                    polygonTemplate.fill = am4core.color("#cccccc");
                    polygonTemplate.stroke = am4core.color("#ffffff");
                    polygonTemplate.strokeWidth = 0.5;
                    polygonTemplate.tooltipText = "{name}";
        
                    polygonTemplate.adapter.add("tooltipText", (text, target) => {
                        const originalMapName = target.dataItem?.dataContext?.name;
                        if (!originalMapName) return text;
                        if (originalMapName === 'Israel' || originalMapName === 'Palestine' || originalMapName === 'Palestinian Territories') {
                            return 'Occupied Palestine';
                        }
                        return this.displayOverrides[originalMapName] || originalMapName;
                    });
        
                    let hs = polygonTemplate.states.create("hover");
                    hs.properties.fill = am4core.color("#999999");
                    let as = polygonTemplate.states.create("active");
                    as.properties.fill = am4core.color("#ffc200");
        
                    polygonTemplate.events.on("hit", (ev) => {
                        const dataContext = ev.target?.dataItem?.dataContext;
                        if (!dataContext || !dataContext.name) return;
                        const originalMapName = dataContext.name;
                        let targetApiName;
                        if (originalMapName === 'Israel' || originalMapName === 'Palestine' || originalMapName === 'Palestinian Territories') {
                            targetApiName = 'Palestine';
                        } else {
                            targetApiName = this.mapNameToApiName[originalMapName] || originalMapName;
                        }
                        const countryData = this.countries.find(c => c.name === targetApiName);
                        if (!countryData || this.excludedStates.has(countryData.code)) {
                             console.log(`Interaction blocked for excluded or unknown API country: ${targetApiName} (from map: ${originalMapName})`);
                             return;
                         }
                        if (this.visitedCountries.has(targetApiName)) {
                            this.removeCountry(targetApiName);
                        } else {
                            this.addCountry(targetApiName);
                        }
                    });
                    chart.zoomControl = new am4maps.ZoomControl();
                }
        
                /** Sets up event listeners for input field, buttons, etc. */
                setupEventListeners() {
                    // Use stored references scoped to the container
                    this.countryInput.addEventListener('input', () => this.handleInput(this.countryInput.value));
                    this.countryInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter') {
                            const firstSuggestion = this.suggestionsDiv.querySelector('.suggestion-item');
                            if (firstSuggestion) {
                                this.addCountry(firstSuggestion.textContent);
                                this.clearInputAndSuggestions();
                            }
                        }
                    });
                    this.suggestionsDiv.addEventListener('click', (e) => {
                        if (e.target.classList.contains('suggestion-item')) {
                            this.addCountry(e.target.textContent);
                            this.clearInputAndSuggestions();
                        }
                    });
                    // Global click listener still needed to hide suggestions
                    document.addEventListener('click', (e) => {
                         // Check if click is outside the input AND outside the suggestions div *within this specific tracker instance*
                        if (!this.countryInput.contains(e.target) && !this.suggestionsDiv.contains(e.target)) {
                            this.suggestionsDiv.style.display = 'none';
                        }
                    });
                    this.resetButton.addEventListener('click', () => this.resetAll());
                    this.compareButton.addEventListener('click', () => this.compareLists());
                }
        
                /** Handles user input in the country text field to show suggestions. */
                handleInput(value) {
                    const trimmedValue = value.trim();
                    if (!trimmedValue) {
                        this.suggestionsDiv.style.display = 'none'; return;
                    }
                    // Accent-insensitive ("Tur" finds Türkiye, "Cura" finds Curaçao), plus common alternate names.
                    const fold = str => str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
                    const aliases = { 'Türkiye': ['turkey'] };
                    const lowerCaseValue = fold(trimmedValue);
                    const matches = this.countries
                        .filter(country => {
                            if (this.excludedStates.has(country.code)) return false;
                            const names = [fold(country.name), ...(aliases[country.name] || [])];
                            return names.some(n => n.includes(lowerCaseValue)) &&
                                   !this.visitedCountries.has(country.name);
                        })
                        .slice(0, 7);
        
                    if (matches.length > 0) {
                        this.suggestionsDiv.innerHTML = matches
                            .map(country => `<div class="suggestion-item" data-country-name="${country.name}">${country.name}</div>`)
                            .join('');
                        this.suggestionsDiv.style.display = 'block';
                    } else {
                        this.suggestionsDiv.style.display = 'none';
                    }
                }
        
                /** Clears the input field and hides the suggestions dropdown. */
                clearInputAndSuggestions() {
                    this.countryInput.value = '';
                    this.suggestionsDiv.style.display = 'none';
                }
        
                /** Adds a country to the user's visited list using the API name. */
                addCountry(apiCountryName) {
                     const countryData = this.countries.find(c => c.name === apiCountryName);
                     if (!countryData || this.excludedStates.has(countryData.code)) {
                         console.warn(`Attempted to add excluded or unknown country: ${apiCountryName}`);
                         return;
                     }
                    if (!this.visitedCountries.has(apiCountryName)) {
                        this.visitedCountries.add(apiCountryName);
                        this.updateUI(); this.saveCountries(); this.hideComparisonResults();
                    }
                }
        
                /** Removes a country from the user's visited list using the API name. */
                removeCountry(apiCountryName) {
                    if (this.visitedCountries.has(apiCountryName)) {
                        this.visitedCountries.delete(apiCountryName);
                        this.updateUI(); this.saveCountries(); this.hideComparisonResults();
                    }
                }
        
                /** Updates the entire UI based on the current state of visitedCountries. */
                updateUI() {
                    this.updateVisitedList();
                    this.updateMapHighlights();
                    this.updateCountryCount();
                }
        
                /** Updates the displayed list of visited countries (uses API names). */
                updateVisitedList() {
                    this.visitedListUl.innerHTML = '';
                    const sortedCountries = Array.from(this.visitedCountries).sort();
                    sortedCountries.forEach(apiCountryName => {
                        const li = document.createElement('li');
                        li.textContent = apiCountryName;
                        const deleteButton = document.createElement('button');
                        deleteButton.className = 'delete-country';
                        deleteButton.innerHTML = '&times;';
                        deleteButton.title = `Remove ${apiCountryName}`;
                        deleteButton.dataset.country = apiCountryName;
                        deleteButton.addEventListener('click', (e) => {
                            e.stopPropagation(); this.removeCountry(deleteButton.dataset.country);
                        });
                        li.appendChild(deleteButton);
                        this.visitedListUl.appendChild(li);
                    });
                }
        
                /** Updates map highlights, linking Israel & Palestine polygons to "Palestine" state */
                updateMapHighlights() {
                    if (!this.polygonSeries) return;
                    const isPalestineVisited = this.visitedCountries.has('Palestine');
                    this.polygonSeries.mapPolygons.each((polygon) => {
                        const dataContext = polygon.dataItem?.dataContext;
                        if (!dataContext || !dataContext.name) { polygon.isActive = false; return; };
                        const originalMapName = dataContext.name;
                        let isActive = false;
                        if (originalMapName === 'Israel' || originalMapName === 'Palestine' || originalMapName === 'Palestinian Territories') {
                            isActive = isPalestineVisited;
                        } else {
                            const apiCountryName = this.mapNameToApiName[originalMapName] || originalMapName;
                            isActive = this.visitedCountries.has(apiCountryName);
                        }
                        polygon.isActive = isActive;
                    });
                }
        
                 /** Updates the displayed count of visited countries AND the count-based banter. */
                 updateCountryCount() {
                    const userCount = this.visitedCountries.size;
                    this.countryCountSpan.textContent = userCount;
                    let sizeComment = '';
                     if (userCount === 0) { sizeComment = ''; }
                     else if (userCount <= 5) { sizeComment = `Don’t worry,the world’s not going anywhere. But apparently, neither are you.`; }
                     else if (userCount <= 15) { sizeComment = `You've been everywhere--if everywhere was what we called places with a Hard Rock Cafe.`; }
                     else if (userCount <= 30) { sizeComment = `Looks like you've been around enough to completely butcher at least four languages.`; }
                     else if (userCount <= 50) { sizeComment = `Respectable numbers. Questionable choices.`; }
                     else { sizeComment = `Alright, Marco Polo, calm down.`; }
                    this.countBanterSpan.textContent = sizeComment;
                 }
        
                /** Saves the current list of visited countries (API names) to localStorage. */
                saveCountries() {
                    try {
                        localStorage.setItem('visitedCountries_tracker', // Use a unique key if multiple trackers might exist
                            JSON.stringify(Array.from(this.visitedCountries)));
                    } catch (e) { console.error("Error saving countries to localStorage:", e); }
                }
        
                /** Loads visited countries (API names) from localStorage when the page loads. */
                loadSavedCountries() {
                    const savedData = localStorage.getItem('visitedCountries_tracker'); // Use unique key
                    if (savedData) {
                        try {
                            const savedApiNames = JSON.parse(savedData);
                            if (Array.isArray(savedApiNames)) {
                                const tempSet = new Set();
                                savedApiNames.forEach(apiCountryName => {
                                    if (apiCountryName === 'Turkey') apiCountryName = 'Türkiye'; // renamed in country data
                                    const isValid = this.countries.some(c => c.name === apiCountryName);
                                    if (isValid) { tempSet.add(apiCountryName); }
                                    else { console.warn(`Removing invalid/outdated country: ${apiCountryName}`); }
                                });
                                this.visitedCountries = tempSet;
                                this.updateUI();
                            } else { throw new Error("Saved data is not an array."); }
                        } catch (e) {
                            console.error("Error parsing saved countries:", e);
                            localStorage.removeItem('visitedCountries_tracker');
                        }
                    } else { this.updateCountryCount(); }
                }
        
                /** Resets the tracker, clearing the user's list and map highlights. */
                resetAll() {
                    if (confirm('Are you sure you want to clear your visited countries list? This cannot be undone.')) {
                        this.visitedCountries.clear();
                        this.updateUI();
                        localStorage.removeItem('visitedCountries_tracker'); // Use unique key
                        this.hideComparisonResults();
                        console.log("Visited countries list has been reset.");
                    }
                }
        
                /** Compares the user's list with the owner's list and displays the results. */
                compareLists() {
                    const userList = this.visitedCountries;
                    const ownerList = this.ownerVisitedCountries;
                    const userCount = userList.size;
                    const bothVisited = [...userList].filter(country => ownerList.has(country)).sort();
                    const userOnlyVisited = [...userList].filter(country => !ownerList.has(country)).sort();
        
                    let html = `<h3>Travel Showdown!</h3>`;
                    html += `<p class="comparison-intro">Okay, let's see... you've marked <strong>${userCount}</strong> ${userCount === 1 ? 'country' : 'countries'} as visited.</p>`;
        
                    if (userCount === 0) {
                        html += `<p class="banter">Zero countries? Really? Come on, click a few places you've been so we can actually compare something!</p>`;
                    } else {
                        if (userOnlyVisited.length === 0 && bothVisited.length > 0) {
                            html += `<p>Looks like you've visited <strong>${bothVisited.length}</strong> ${bothVisited.length === 1 ? 'country' : 'countries'} that I have too.</p>`;
                            html += `<ul>${bothVisited.map(c => `<li>${c}</li>`).join('')}</ul>`;
                            html += `<p class="banter">At this rate, your passport should just say "Ask Omar first."</p>`;
                        } else if (userOnlyVisited.length > 0 && bothVisited.length === 0) {
                             html += `<p>You've visited <strong>${userOnlyVisited.length}</strong> ${userOnlyVisited.length === 1 ? 'country' : 'countries'}, none of which I've been to.</p>`;
                             html += `<ul>${userOnlyVisited.map(c => `<li>${c}</li>`).join('')}</ul>`;
                             html += `<p class="banter">No overlaps? I guess someone had to take the road less interesting. Jk, I'm actually super jealous.</p>`;
                        } else if (userOnlyVisited.length > 0 && bothVisited.length > 0) {
                            html += `<p>We have <strong>${bothVisited.length}</strong> ${bothVisited.length === 1 ? 'country' : 'countries'} in common.</p>`;
                            html += `<ul>${bothVisited.map(c => `<li>${c}</li>`).join('')}</ul>`;
                            html += `<p class="banter">Look at us--two people making customs officers nervous in the same places.</p>`;
                            html += `<p>And you've been to <strong>${userOnlyVisited.length}</strong> ${userOnlyVisited.length === 1 ? 'country' : 'countries'} I haven't been to...yet.</p>`;
                            html += `<ul>${userOnlyVisited.map(c => `<li>${c}</li>`).join('')}</ul>`;
                            html += `<p class="banter">Bold of you to visit places even I couldn't be bothered with.</p>`;
                        }
                    }
                    this.comparisonResultsDiv.innerHTML = html;
                    this.comparisonResultsDiv.style.display = 'block';
                    this.comparisonResultsDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
        
                /** Hides the comparison results section. */
                hideComparisonResults() {
                     if (this.comparisonResultsDiv) {
                         this.comparisonResultsDiv.style.display = 'none';
                         this.comparisonResultsDiv.innerHTML = '';
                     }
                }
            }
        
            // --- Initialization ---
            // Find the specific container for this tracker instance
            const trackerContainer = document.querySelector('#journeys .travel-tracker-container'); // Use a specific selector
            if (trackerContainer) {
                 // Create an instance of the CountryTracker class, passing the container
                const trackerInstance = new CountryTracker(trackerContainer);
            } else {
                console.error("Could not find the travel tracker container element (#journeys .travel-tracker-container).");
            }
        
        </script>        
    </div>
  </section>

