<script>
  // ---- helpers ----
  const store = { get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
  document.getElementById('year').textContent = new Date().getFullYear();

  // ---- reveal on scroll (no horizontal offsets, so nothing pokes off-screen on phones) ----
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ---- highlight the section you're in ----
  const navLinks = [...document.querySelectorAll('#nav a')];
  const spy = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) {
    navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
    const on = navLinks.find(a => a.classList.contains('active'));
    if (on && matchMedia('(max-width: 760px)').matches) on.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
  } }), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id]').forEach(sec => spy.observe(sec));

  // ---- colors include... ----
  const colors = [['Green', '#1f9d55'], ['Red', '#e0281e'], ['Purple', '#7e22ce'], ['Blue', '#1d4ed8'], ['Orange', '#f97316'], ['Pink', '#ec4899'], ['Yellow', '#ffc200'], ['Several', null]];
  const cyc = document.getElementById('cycle'); let ci = 0;
  setInterval(() => { ci = (ci + 1) % colors.length; cyc.textContent = colors[ci][0]; cyc.style.color = colors[ci][1] || ''; cyc.classList.toggle('rainbow', !colors[ci][1]); cyc.classList.toggle('on-ink', colors[ci][0] === 'Yellow'); }, 1800);
  cyc.style.color = colors[0][1];

  // ---- time wasted ----
  const t0 = Date.now(), wasted = document.getElementById('wasted');
  setInterval(() => { const s = Math.floor((Date.now() - t0) / 1000); wasted.textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }, 1000);

  // ---- crucial song ----
  const song = document.getElementById('song'), songBtn = document.getElementById('songBtn');
  const syncSong = () => { const on = !song.paused; songBtn.setAttribute('aria-pressed', String(on)); songBtn.textContent = on ? '♪ crucial song: on (tap to stop)' : '♪ crucial song: off'; };
  song.addEventListener('play', syncSong); song.addEventListener('pause', syncSong);
  songBtn.addEventListener('click', () => { if (song.paused) song.play().catch(() => {}); else song.pause(); });
  syncSong();

  // ---- gallery arrows ----
  const gal = document.getElementById('gallery');
  document.querySelectorAll('.arrows button').forEach(b => b.addEventListener('click', () => gal.scrollBy({ left: Number(b.dataset.dir) * (gal.querySelector('figure').offsetWidth + 20), behavior: 'smooth' })));
  // custom scrollbar: thumb size/position mirror the gallery; drag or click the track to scroll
  const track = document.getElementById('track'), thumb = document.getElementById('thumb');
  function syncThumb() {
    const ratio = gal.clientWidth / gal.scrollWidth, tw = track.clientWidth;
    thumb.style.width = Math.max(ratio * tw, 40) + 'px';
    const max = gal.scrollWidth - gal.clientWidth;
    thumb.style.transform = `translateX(${max > 0 ? (gal.scrollLeft / max) * (tw - thumb.offsetWidth) : 0}px)`;
  }
  gal.addEventListener('scroll', syncThumb, { passive: true }); addEventListener('resize', syncThumb); addEventListener('load', syncThumb); syncThumb();
  function scrollToPointer(x, grabOffset) {
    const r = track.getBoundingClientRect(), span = r.width - thumb.offsetWidth;
    const f = Math.min(1, Math.max(0, (x - r.left - grabOffset) / span));
    gal.scrollLeft = f * (gal.scrollWidth - gal.clientWidth);
  }
  track.addEventListener('pointerdown', e => {
    const tr = thumb.getBoundingClientRect();
    const grab = (e.target === thumb) ? e.clientX - tr.left : thumb.offsetWidth / 2;
    gal.style.scrollSnapType = 'none'; thumb.classList.add('drag'); track.setPointerCapture(e.pointerId);
    scrollToPointer(e.clientX, grab);
    const move = ev => scrollToPointer(ev.clientX, grab);
    const up = () => { thumb.classList.remove('drag'); gal.style.scrollSnapType = ''; track.removeEventListener('pointermove', move); track.removeEventListener('pointerup', up); track.removeEventListener('pointercancel', up); };
    track.addEventListener('pointermove', move); track.addEventListener('pointerup', up); track.addEventListener('pointercancel', up);
  });

  // ---- cookie banner ----
  const cookie = document.getElementById('cookie');
  if (!store.get('cookieJoke')) setTimeout(() => cookie.classList.add('show'), 2500);
  cookie.querySelectorAll('[data-ok]').forEach(b => b.addEventListener('click', () => { cookie.classList.remove('show'); store.set('cookieJoke', '1'); }));

  // ---- shortener ----
  const sForm = document.getElementById('shortenForm'), sCode = document.getElementById('sCode'), sUrl = document.getElementById('sUrl'), sRes = document.getElementById('sResult'), sBtn = document.getElementById('sBtn');
  const adj = ['suspicious', 'legit', 'totally', 'mildly', 'bombastic', 'eccentric', 'unhinged', 'certified', 'official', 'sketchy'];
  const noun = ['falafel', 'pyramid', 'camel', 'koshari', 'pharaoh', 'mango', 'link', 'deal', 'portal', 'rock'];
  const pick = a => a[Math.floor(Math.random() * a.length)];
  document.getElementById('dice').addEventListener('click', () => { sCode.value = pick(adj) + pick(noun) + Math.floor(Math.random() * 90 + 10); sCode.focus(); });
  const wins = ['Minted. Tell your friends you know a guy.', 'Done. You’ve officially been Battisha’d.', 'Congratulations. This link is now 40% more legitimate.', 'Link created. I take no responsibility for where it goes.'];
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  async function loadCount() { try { const r = await fetch('/api/shorten'); const d = await r.json(); document.getElementById('linkCount').textContent = d.count; } catch (e) {} }
  loadCount();
  sForm.addEventListener('submit', async e => {
    e.preventDefault();
    sBtn.disabled = true; sBtn.textContent = 'Minting…';
    try {
      const r = await fetch('/api/shorten', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ shortcode: sCode.value.trim(), url: sUrl.value.trim() }) });
      const d = await r.json();
      sRes.className = 'result show' + (r.ok ? '' : ' err');
      if (r.ok) {
        sRes.innerHTML = `<div class="fine">${esc(pick(wins))}</div><div class="link"><a href="${esc(d.short)}" target="_blank" rel="noopener">${esc(d.short.replace('https://', ''))}</a><button type="button" class="copy">Copy</button></div>`;
        sRes.querySelector('.copy').addEventListener('click', ev => { navigator.clipboard.writeText(d.short).then(() => { ev.target.textContent = 'Copied. Go forth.'; }); });
        sForm.reset(); loadCount();
      } else {
        sRes.innerHTML = `<b>${esc(d.error || 'Something broke. Probably your fault.')}</b>`;
      }
    } catch (err) {
      sRes.className = 'result show err'; sRes.innerHTML = '<b>Couldn’t reach the link factory. Try again.</b>';
    } finally { sBtn.disabled = false; sBtn.textContent = 'Mint my link'; }
  });

  // ---- how much did Omar sleep ----
  (async () => {
    const Q = [
      [3, ['That’s not sleep, that’s a nap with ambition.', 'Someone check on him.', 'Blinked aggressively, then got up.']],
      [5, ['Running on vibes and caffeine.', 'Concerning. He’ll say he’s fine.', 'Respectfully, go to bed.']],
      [7, ['Functional, allegedly.', 'Could be worse. Has been worse.', 'A solid “meh”.']],
      [9, ['Suspiciously responsible.', 'Who is this man and what has he done with Omar?', 'Well-rested and insufferable about it.']],
      [99, ['Hibernating. Do not disturb.', 'Unemployed behavior.', 'Basically a bear now.']],
    ];
    const $z = id => document.getElementById(id);
    let d;
    try { d = await (await fetch('/api/sleep', { cache: 'no-store' })).json(); } catch (e) { d = {}; }
    if (!d.hasData) {
      $z('zHrs').innerHTML = '??<small>h</small>';
      $z('zQuip').textContent = d.connected === false ? 'Data unavailable. Omar’s sleep is classified.' : 'The ring is being shy. Try again later.';
      return;
    }
    const h = d.seconds / 3600;
    let hh = Math.floor(h), mm = Math.round((h - hh) * 60); if (mm === 60) { hh++; mm = 0; }
    $z('zHrs').innerHTML = `${hh}<small>h</small> ${mm}<small>m</small>`;
    $z('zQuip').textContent = pick(Q.find(([max]) => h < max)[1]);
    requestAnimationFrame(() => { $z('zFill').style.width = Math.min(100, h * 10) + '%'; });
    if (!d.isLastNight) {
      const day = new Date(d.day + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
      $z('zWhen').textContent = `Most recent night on record · ${day}`;
      $z('zStale').hidden = false; $z('zStale').textContent = 'His ring hasn’t synced since. Draw your own conclusions.';
    }
  })();

  // ---- hire me (runs away; gives up after 10 tries) ----
  const hireTaunts = ['Not like that.', 'Too eager.', 'Playing hard to get.', 'Salary expectations: yes.', 'I have other offers. (I don’t.)',
                      'Have you tried LinkedIn?', 'Still interviewing other visitors.', 'Persistence noted.', 'Okay okay okay.'];
  dodge(document.getElementById('hire'), {
    area: document.getElementById('colors'), limit: 10,
    onDodge(n) { document.getElementById('hireTaunt').textContent = hireTaunts[Math.min(n - 1, hireTaunts.length - 1)]; },
    onGiveUp(el) { el.textContent = 'Fine. Email me.'; el.classList.add('settled'); document.getElementById('hireTaunt').textContent = 'You’ve earned it.'; },
  });

  // ---- arriving from a 404 short link: pre-fill it in the shortener ----
  const claim = new URLSearchParams(location.search).get('claim');
  if (claim && /^[a-zA-Z0-9]{1,40}$/.test(claim)) document.getElementById('sCode').value = claim;

  // ---- "tell me more about yourself" ----
  const ssnInput = document.getElementById('ssn'), infoForm = document.getElementById('infoForm');
  ssnInput.addEventListener('input', function () {
    this.setCustomValidity('');
    document.getElementById('error-message').style.display = 'none';
    const d = this.value.replace(/\D/g, '').slice(0, 9);
    this.value = d.length > 5 ? `${d.slice(0, 3)}-${d.slice(3, 5)}-${d.slice(5)}` : d.length > 3 ? `${d.slice(0, 3)}-${d.slice(3)}` : d;
  });
  // Standard SSN format rules, checked in the browser (nothing typed here is sent anywhere):
  // area can't be 000, 666 or 9xx; group can't be 00; serial can't be 0000.
  function ssnLooksValid(ssn) {
    const m = /^(\d{3})-(\d{2})-(\d{4})$/.exec(ssn);
    if (!m) return false;
    const [, area, group, serial] = m;
    return area !== '000' && area !== '666' && area[0] !== '9' && group !== '00' && serial !== '0000';
  }
  infoForm.addEventListener('submit', e => {
    e.preventDefault();
    if (!infoForm.checkValidity()) { infoForm.reportValidity(); return; }
    if (!ssnLooksValid(ssnInput.value)) { ssnInput.setCustomValidity('Invalid SSN'); ssnInput.reportValidity(); return; }
    infoForm.reset();
    window.location.href = '/submit';
  });
</script>
</body>
</html>
