<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A public service announcement about one man's sleep.">
  <title>Is Omar Asleep?</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="apple-touch-icon" sizes="180x180" href="favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png">
  <link rel="shortcut icon" href="favicon/favicon.ico">
  <meta name="theme-color" content="#0f1830">
  <style>
    :root {
      --ink: #141414; --paper: #f6f3ea; --yellow: #ffc200; --night: #0f1830; --night-2: #1a2747;
      --moon: #f6f3ea; --dim: rgba(246, 243, 234, .62); --rule: rgba(246, 243, 234, .16);
      --yes: #8fd3ff; --no: #ffc200; --maybe: #c9b6ff;
      --display: "Archivo Black", "Arial Black", sans-serif; --body: "Archivo", system-ui, sans-serif; --mono: "IBM Plex Mono", ui-monospace, monospace;
    }
    * { box-sizing: border-box; }
    html { overflow-x: clip; }
    body { margin: 0; min-height: 100vh; background: var(--night); color: var(--moon); font-family: var(--body); font-size: 17px; line-height: 1.55; overflow-x: clip;
      background-image: radial-gradient(1px 1px at 12% 18%, #fff8 50%, transparent 51%), radial-gradient(1px 1px at 78% 12%, #fff6 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 64% 38%, #fff7 50%, transparent 51%), radial-gradient(1px 1px at 30% 62%, #fff5 50%, transparent 51%),
        radial-gradient(1px 1px at 88% 70%, #fff6 50%, transparent 51%), radial-gradient(1.5px 1.5px at 6% 86%, #fff5 50%, transparent 51%); }
    a { color: inherit; }
    .bar { position: sticky; top: 0; z-index: 10; background: var(--ink); }
    .bar-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 clamp(14px, 2vw, 28px); font-family: var(--mono); font-size: 13px; }
    .bar .logo { width: 34px; height: 34px; color: var(--yellow); display: block; }
    .bar a.back { text-decoration: none; opacity: .75; } .bar a.back:hover { opacity: 1; color: var(--yellow); }
    .wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; }
    .label { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .12em; color: var(--dim); margin: 0 0 14px; }
    .label b { color: var(--ink); background: var(--yellow); padding: 1px 6px; font-weight: 600; }
    h1, h2 { font-family: var(--display); font-weight: 400; line-height: .95; letter-spacing: -.02em; margin: 0; }

    .hero { padding: 72px 0 40px; }
    .hero h1 { font-size: clamp(34px, 6vw, 64px); max-width: 14ch; }
    .answer { font-family: var(--display); font-size: clamp(88px, 22vw, 240px); line-height: .9; letter-spacing: -.04em; margin: 28px 0 8px; color: var(--maybe); min-height: .9em; }
    .answer.yes { color: var(--yes); } .answer.no { color: var(--no); }
    .answer.long { font-size: clamp(56px, 12.5vw, 150px); }
    .answer .z { display: inline-block; font-size: .3em; vertical-align: top; animation: z 2.4s ease-in-out infinite; color: var(--dim); }
    .answer .z:nth-child(2) { animation-delay: .4s; } .answer .z:nth-child(3) { animation-delay: .8s; }
    @keyframes z { 0%, 100% { transform: translateY(0); opacity: .3; } 50% { transform: translateY(-.4em); opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .answer .z { animation: none; } }
    .basis { font-size: 19px; color: var(--dim); max-width: 52ch; margin: 0; }
    .text-him { display: inline-flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; margin-top: 22px; font-family: var(--mono); font-size: 13px; border: 1px solid var(--rule); border-radius: 14px; padding: 8px 14px; }
    .text-him b { color: var(--yellow); }

    .card { background: var(--paper); color: var(--ink); border: 2px solid var(--ink); border-radius: 16px; box-shadow: 8px 8px 0 var(--yellow); padding: clamp(20px, 4vw, 36px); margin: 32px 8px 0 0; }
    .card .label { color: #6b675e; }
    .hours { font-family: var(--display); font-size: clamp(64px, 14vw, 140px); line-height: .9; letter-spacing: -.03em; margin: 6px 0 4px; }
    .hours small { font-size: .38em; letter-spacing: 0; }
    .verdict { font-size: 22px; font-weight: 700; margin: 8px 0 24px; }
    .gauge { position: relative; height: 14px; background: #e6e1d3; border-radius: 99px; overflow: hidden; margin: 8px 0 6px; }
    .gauge .fill { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--ink); border-radius: 99px; transition: width 1.2s cubic-bezier(.2, .8, .2, 1); }
    .gauge .ok { position: absolute; top: 0; bottom: 0; left: calc(7 / 10 * 100%); width: calc(2 / 10 * 100%); background: rgba(46, 158, 91, .35); }
    .gauge-legend { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; color: #6b675e; }
    .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 28px; border-top: 1px solid rgba(20, 20, 20, .14); padding-top: 20px; }
    .facts div span { display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: #6b675e; }
    .facts div b { font-family: var(--display); font-weight: 400; font-size: 26px; }
    @media (max-width: 560px) { .facts { grid-template-columns: 1fr 1fr; } }

    .fine { font-family: var(--mono); font-size: 11px; color: var(--dim); margin: 28px 0 0; }
    .card .fine { color: #6b675e; }
    footer { padding: 72px 0 56px; font-family: var(--mono); font-size: 12px; color: var(--dim); }
    .loading .answer, .loading .card { opacity: .35; }
  </style>
</head>
<body class="loading">
<header class="bar"><div class="bar-inner">
  <a href="/" title="battisha.com"><svg class="logo" role="img" aria-label="Battisha" viewBox="0 0 472 472" preserveAspectRatio="xMidYMid meet"><g transform="translate(0,472) scale(0.1,-0.1)" fill="currentColor"><path d="M1379 4693 c0 -15 -2 -46 -4 -68 -3 -42 -11 -181 -30 -563 l-6 -127 92 93 c50 51 100 97 110 103 23 12 53 -2 69 -31 10 -18 6 -282 -5 -380 -2 -19 -6 -78 -10 -130 -4 -52 -9 -120 -11 -150 -14 -197 -2 -359 35 -465 56 -156 194 -303 286 -305 14 0 -28 -47 -145 -161 -91 -89 -269 -263 -396 -387 -126 -125 -402 -395 -612 -601 -210 -206 -382 -377 -382 -380 0 -3 629 -6 1397 -6 1560 0 1432 6 1550 -71 133 -88 313 -303 364 -437 12 -31 25 -57 28 -57 3 0 40 32 81 71 41 39 135 128 209 198 324 304 352 343 357 504 3 84 0 101 -32 195 -19 57 -95 224 -169 372 -225 450 -238 497 -198 674 8 32 12 60 11 62 -4 3 -111 -98 -267 -249 -123 -121 -163 -181 -191 -286 -30 -115 -6 -207 127 -481 185 -379 213 -446 213 -501 0 -15 -9 -49 -21 -76 l-20 -48 -182 186 c-224 227 -300 290 -412 340 l-50 23 -825 0 -825 1 -55 31 c-67 38 -116 108 -106 150 9 33 134 158 452 451 54 50 117 109 140 130 55 52 270 252 303 282 14 13 84 78 156 145 228 213 239 224 276 258 40 37 268 249 309 288 15 14 82 77 150 140 68 63 149 138 179 167 l55 52 -75 -19 c-137 -35 -295 -46 -385 -25 l-52 12 -98 -98 c-161 -159 -249 -201 -429 -203 -128 -1 -192 16 -269 71 -75 54 -113 103 -154 200 -26 61 -30 86 -37 218 -15 317 -21 380 -37 437 -8 29 -61 86 -234 258 -202 200 -224 219 -225 193z"/><path d="M2480 587 c-124 -107 -189 -174 -206 -214 -27 -61 15 -117 118 -162 71 -30 160 -91 214 -148 29 -29 54 -53 57 -53 15 0 121 192 136 247 16 58 0 91 -103 228 -46 61 -90 127 -97 148 -7 20 -15 37 -19 37 -3 0 -48 -37 -100 -83z"/></g></svg></a>
  <a class="back" href="/main">← back to the website</a>
</div></header>

<main class="wrap">
  <section class="hero">
    <p class="label"><b>LIVE*</b> A public service announcement</p>
    <h1>Is Omar asleep right now?</h1>
    <div class="answer" id="answer">…</div>
    <p class="basis" id="basis">Consulting the ring…</p>
    <div class="text-him" id="textHim" hidden>Should you text him? <b id="textAnswer"></b></div>
  </section>

  <section class="card" id="card" hidden>
    <p class="label"><span id="nightLabel">Last night</span> (<span id="night"></span>), Omar slept</p>
    <div class="hours" id="hours"></div>
    <div class="verdict" id="verdict"></div>
    <div class="gauge" aria-hidden="true"><div class="ok"></div><div class="fill" id="fill"></div></div>
    <div class="gauge-legend"><span>0h</span><span>recommended: 7–9h</span><span>10h</span></div>
    <div class="facts">
      <div><span>Went to bed</span><b id="bed">—</b></div>
      <div><span>Woke up</span><b id="wake">—</b></div>
      <div><span>Sleep score</span><b id="score">—</b></div>
      <div><span>Usual bedtime</span><b id="usualStart">—</b></div>
      <div><span>Usual wake-up</span><b id="usualEnd">—</b></div>
      <div><span>Sleep attempts</span><b id="pieces">—</b></div>
    </div>
    <p class="fine">Data from an Oura ring, which only updates when it syncs with his phone. Times are Omar’s local time.</p>
  </section>

  <p class="fine">*“Live” is doing a lot of work here.</p>
</main>

<footer class="wrap">© <span id="year"></span> Bombastic Industries. Sleep data used with the subject’s reluctant consent.</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
  const $ = id => document.getElementById(id);

  function clock(iso, tz) {
    const d = new Date(Date.parse(iso) + tz * 60000);
    let h = d.getUTCHours(), m = d.getUTCMinutes();
    const ap = h >= 12 ? 'pm' : 'am'; h = h % 12 || 12;
    return `${h}:${String(m).padStart(2, '0')}${ap}`;
  }
  const hhmm = s => { if (!s) return '—'; let [h, m] = s.split(':').map(Number); const ap = h >= 12 ? 'pm' : 'am'; h = h % 12 || 12; return `${h}:${String(m).padStart(2, '0')}${ap}`; };
  function ago(iso) {
    const min = Math.round((Date.now() - Date.parse(iso)) / 60000);
    if (min < 60) return `${min} minute${min === 1 ? '' : 's'} ago`;
    const h = Math.round(min / 60); if (h < 48) return `${h} hour${h === 1 ? '' : 's'} ago`;
    return `${Math.round(h / 24)} days ago`;
  }
  const tzName = tz => tz === -480 ? 'Pacific' : tz === -420 ? 'Pacific' : `UTC${tz >= 0 ? '+' : '−'}${Math.abs(tz / 60)}`;

  const ANSWERS = {
    yes: ['YES', 'yes', 'According to his ring, as of {sync}. Please lower your voice.'],
    no: ['NO', 'no', 'His ring says he’s up and about, as of {sync}. No excuses for not replying.'],
    probably: ['PROBABLY', 'maybe', 'His ring last synced {sync}, so this is an educated guess. He’s usually out between {start} and {end} ({tz}).'],
    probably_not: ['PROBABLY NOT', 'maybe', 'His ring last synced {sync}, so this is an educated guess. He’s usually asleep between {start} and {end} ({tz}), and it’s not that.'],
  };
  const TEXT = { yes: 'No. Let him sleep.', no: 'Yes. He’s awake and ignoring you.', probably: 'Risky.', probably_not: 'Sure, he’ll leave you on read either way.' };
  function verdictFor(h) {
    if (h < 3) return 'That’s not sleep, that’s a nap with ambition.';
    if (h < 5) return 'Concerning. Someone check on him.';
    if (h < 7) return 'Functional, allegedly.';
    if (h <= 9) return 'Suspiciously responsible.';
    return 'Hibernating. Do not disturb.';
  }

  async function load() {
    let d;
    try { d = await (await fetch('/api/sleep', { cache: 'no-store' })).json(); } catch (e) { d = { error: true }; }
    document.body.classList.remove('loading');
    const answer = $('answer'), basis = $('basis');
    if (!d.connected || d.error || !d.hasData) {
      answer.innerHTML = 'UNCLEAR'; answer.className = 'answer';
      basis.textContent = !d.connected ? 'Omar’s ring isn’t talking to this website yet. He’s probably asleep, honestly.' : 'The ring is being shy right now. Try again in a bit.';
      return;
    }
    const [word, cls, line] = ANSWERS[d.asleep];
    answer.className = 'answer ' + cls + (word.length > 4 ? ' long' : '');
    answer.innerHTML = word + (d.asleep === 'yes' ? '<span style="white-space:nowrap"> <span class="z">z</span><span class="z">z</span><span class="z">z</span></span>' : '');
    basis.textContent = line.replace('{sync}', d.lastSync ? ago(d.lastSync) : 'a while ago').replace('{start}', hhmm(d.usual.start)).replace('{end}', hhmm(d.usual.end)).replace('{tz}', tzName(d.tzOffsetMinutes));
    $('textHim').hidden = false; $('textAnswer').textContent = TEXT[d.asleep];

    const n = d.lastNight, hrs = n.seconds / 3600;
    $('card').hidden = false;
    // Oura only has a night once the ring syncs; if the newest night isn't last night, say so.
    const localToday = new Date(Date.now() + d.tzOffsetMinutes * 60000).toISOString().slice(0, 10);
    $('nightLabel').textContent = n.day === localToday ? 'Last night' : 'His most recent synced night';
    $('night').textContent = new Date(n.day + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' });
    $('hours').innerHTML = `${Math.floor(hrs)}<small>h</small> ${Math.round((hrs % 1) * 60)}<small>m</small>`;
    $('verdict').textContent = verdictFor(hrs);
    requestAnimationFrame(() => { $('fill').style.width = Math.min(100, hrs / 10 * 100) + '%'; });
    $('bed').textContent = n.bedtime ? clock(n.bedtime, d.tzOffsetMinutes) : '—';
    $('wake').textContent = n.wake ? clock(n.wake, d.tzOffsetMinutes) : '—';
    $('score').textContent = n.score != null ? `${n.score}/100` : '—';
    $('usualStart').textContent = hhmm(d.usual.start); $('usualEnd').textContent = hhmm(d.usual.end);
    $('pieces').textContent = n.periods;
  }
  load();
</script>
</body>
</html>
