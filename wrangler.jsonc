{
  "name": "battisha-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    { "binding": "SHORTCODES", "id": "5515977d3f3344dd9ba89abd079ec2b0" },
    { "binding": "SITE", "id": "dbf0b80728d247c99a5d4506bd31f1da" },
    { "binding": "PRIVATE", "id": "d48a0b036f3d4903943e39b2460c72dd" }  // Oura tokens + sleep cache; never served
  ],
  // Direct link to the oura-mcp Worker (used by the sleep section; see src/sleep.js)
  "services": [{ "binding": "OURA_MCP", "service": "oura-mcp" }],
  "workers_dev": true,
  "routes": [
    { "pattern": "battisha.com", "custom_domain": true },
    { "pattern": "www.battisha.com", "custom_domain": true },
    { "pattern": "shorten.battisha.com", "custom_domain": true }
  ]
}
